# Required: the key every request must send in the X-API-Key header
API_KEY=change-me
PORT=3000
# SQLite file location (mount a persistent disk here in production)
DB_PATH=./data/clinic.db
# Comma-separated origins allowed by CORS (default: *)
CORS_ORIGIN=*
# Optional tuning
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
IDEMPOTENCY_TTL_MS=86400000
# Load demo data on startup when the database is empty
SEED_ON_START=false
