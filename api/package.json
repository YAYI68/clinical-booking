{
  "name": "clinic-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic booking API (NestJS)",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/main.js)",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "seed:db": "node --env-file-if-exists=.env scripts/seed-db.mjs"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
